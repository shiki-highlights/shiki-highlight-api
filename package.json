{
  "name": "shiki-highlight-api",
  "version": "1.1.0",
  "description": "High-performance syntax highlighting using CSS Custom Highlight API (87% fewer DOM nodes)",
  "keywords": [
    "shiki",
    "syntax-highlighting",
    "highlight-api",
    "performance",
    "markdown",
    "code",
    "css-highlights"
  ],
  "author": "Steve Hill <steve@stevehill.xyz>",
  "license": "MIT",
  "homepage": "https://github.com/shiki-highlights/shiki-highlight-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiki-highlights/shiki-highlight-api.git"
  },
  "bugs": {
    "url": "https://github.com/shiki-highlights/shiki-highlight-api/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "hast-util-to-string": "^3.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "shiki": ">=1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
